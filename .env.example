# YouTube API Credentials
# Get these from https://console.cloud.google.com/
YOUTUBE_CLIENT_ID=your_client_id
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:50555/api/auth/youtube

# Share-access token string (Exported securely via /api/youtube/export-tokens)
# Use this on the assistant's local machine to allow full access without Google login.
# (Leave empty on the owner's machine)
YOUTUBE_SHARED_TOKENS=

