{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube Studio Agent",
  "version": "1.0.0",
  "identifier": "com.bedri.youtubestudioagent",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:50555",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "YouTube Studio Agent",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
